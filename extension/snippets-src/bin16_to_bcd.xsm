; @name BIN 16-bit to BCD
; @prefix bin16_to_bcd
; @description Convert an unsigned 16-bit binary value to 3-byte packed BCD
; @placeholder FR0
; @placeholder FR1

; -----------------------------------------------------------------------------
; Convert an unsigned 16-bit binary value to 3-byte packed BCD.
;
; Input:
;   X       - binary value, low byte
;   Y       - binary value, high byte
;
; Output:
;   FR0     - packed BCD result, 3 bytes
;
;             FR0     FR0+1   FR0+2
;             ------  ------  ------
;             00..06  00..99  00..99
;
;   Example:
;
;     $FFFF = 65535
;
;     FR0   = $06
;     FR0+1 = $55
;     FR0+2 = $35
;
; Temporary:
;   FR1     - shifted binary value, 16-bit
;
; Clobbers:
;   A, X, Y, FR1, FR1+1, flags
;
; Notes:
;   Decimal mode is used during the conversion.
;   Decimal mode is clear on return.
;
;   The conversion processes the binary value one bit at a time:
;
;     BCD = BCD * 2 + next_bit
;
;   ADC in decimal mode performs the required BCD correction automatically.
; -----------------------------------------------------------------------------

bin16_to_bcd
	; Store the binary input.
	stx	FR1
	sty	FR1+1

	; Clear the 3-byte BCD result.
	lda	#0
	sta	FR0
	sta	FR0+1
	sta	FR0+2

	; Process all 16 input bits, starting with the most significant bit.
	ldy	#15

	sed

?next_bit
	; Shift the next binary bit into carry.
	asl	FR1
	rol	FR1+1

	; Double the packed BCD value and add the input bit.
	;
	; The carry from ROL is deliberately left untouched:
	; it contains the next binary bit to add.
	;
	; Carry generated by each BCD byte then propagates into the
	; next more significant BCD byte.
	ldx	#2

?double_bcd
	lda	FR0,x
	adc	FR0,x
	sta	FR0,x

	dex
	bpl	?double_bcd

	dey
	bpl	?next_bit

	cld
	rts
