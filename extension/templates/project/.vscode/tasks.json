{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "compile (xasm)",
      "type": "shell",
      "command": "xasm",
      "args": [
        "/o:${fileBasenameNoExtension}.xex",
        "${file}"
      ],
      "options": {
        "cwd": "${fileDirname}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "run (emulator)",
      "type": "shell",
      "linux": {
        "command": "atari800",
        "args": [
          "-run",
          "${fileBasenameNoExtension}.xex"
        ],
        "options": {
          "cwd": "${fileDirname}"
        }
      },
      "osx": {
        "command": "open",
        "args": [
          "-W",
          "${fileBasenameNoExtension}.xex"
        ],
        "options": {
          "cwd": "${fileDirname}"
        }
      },
      "windows": {
        "command": "cmd",
        "args": [
          "/c",
          "start",
          "",
          "/wait",
          "${fileBasenameNoExtension}.xex"
        ],
        "options": {
          "cwd": "${fileDirname}"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "build & run",
      "dependsOrder": "sequence",
      "dependsOn": [
        "compile (xasm)",
        "run (emulator)"
      ],
      "problemMatcher": []
    },
    {
      "label": "run (atari800 prelaunch)",
      "type": "shell",
      "command": "bash",
      "args": [
        "-lc",
        "echo __XASM_ATARI800_STARTING__; echo __XASM_ATARI800_READY__; exec atari800 -run \"$1\"",
        "_",
        "${fileBasenameNoExtension}.xex"
      ],
      "options": {
        "cwd": "${fileDirname}"
      },
      "isBackground": true,
      "hide": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "a^"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^__XASM_ATARI800_STARTING__$",
          "endsPattern": "^__XASM_ATARI800_READY__$"
        }
      }
    },
    {
      "label": "build & run (atari800 prelaunch)",
      "dependsOrder": "sequence",
      "dependsOn": [
        "compile (xasm)",
        "run (atari800 prelaunch)"
      ],
      "hide": true,
      "problemMatcher": []
    }
  ]
}
