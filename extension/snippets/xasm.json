{
  "BIN 16-bit to BCD": {
    "prefix": "bin16_to_bcd",
    "body": [
      "; -----------------------------------------------------------------------------",
      "; Convert an unsigned 16-bit binary value to 3-byte packed BCD.",
      ";",
      "; Input:",
      ";   X       - binary value, low byte",
      ";   Y       - binary value, high byte",
      ";",
      "; Output:",
      ";   ${1:FR0}     - packed BCD result, 3 bytes",
      ";",
      ";             $1     $1+1   $1+2",
      ";             ------  ------  ------",
      ";             00..06  00..99  00..99",
      ";",
      ";   Example:",
      ";",
      ";     \\$FFFF = 65535",
      ";",
      ";     $1   = \\$06",
      ";     $1+1 = \\$55",
      ";     $1+2 = \\$35",
      ";",
      "; Temporary:",
      ";   ${2:FR1}     - shifted binary value, 16-bit",
      ";",
      "; Clobbers:",
      ";   A, X, Y, $2, $2+1, flags",
      ";",
      "; Notes:",
      ";   Decimal mode is used during the conversion.",
      ";   Decimal mode is clear on return.",
      ";",
      ";   The conversion processes the binary value one bit at a time:",
      ";",
      ";     BCD = BCD * 2 + next_bit",
      ";",
      ";   ADC in decimal mode performs the required BCD correction automatically.",
      "; -----------------------------------------------------------------------------",
      "",
      "bin16_to_bcd",
      "\t; Store the binary input.",
      "\tstx\t$2",
      "\tsty\t$2+1",
      "",
      "\t; Clear the 3-byte BCD result.",
      "\tlda\t#0",
      "\tsta\t$1",
      "\tsta\t$1+1",
      "\tsta\t$1+2",
      "",
      "\t; Process all 16 input bits, starting with the most significant bit.",
      "\tldy\t#15",
      "",
      "\tsed",
      "",
      "?next_bit",
      "\t; Shift the next binary bit into carry.",
      "\tasl\t$2",
      "\trol\t$2+1",
      "",
      "\t; Double the packed BCD value and add the input bit.",
      "\t;",
      "\t; The carry from ROL is deliberately left untouched:",
      "\t; it contains the next binary bit to add.",
      "\t;",
      "\t; Carry generated by each BCD byte then propagates into the",
      "\t; next more significant BCD byte.",
      "\tldx\t#2",
      "",
      "?double_bcd",
      "\tlda\t$1,x",
      "\tadc\t$1,x",
      "\tsta\t$1,x",
      "",
      "\tdex",
      "\tbpl\t?double_bcd",
      "",
      "\tdey",
      "\tbpl\t?next_bit",
      "",
      "\tcld",
      "\trts",
      "$0"
    ],
    "description": "Convert an unsigned 16-bit binary value to 3-byte packed BCD"
  },
  "Detect Stereo Routine": {
    "prefix": "stereo",
    "body": [
      "; STEREO detect routine",
      ";",
      "; IN : none",
      "; OUT: X = 0 - mono, X = 1 - stereo",
      "",
      "${1:detect_stereo}",
      "",
      "\tldx\t#\\$00",
      "\tstx\t\\$d20f\t; halt POKEY #0",
      "\tstx\t\\$d21f\t; halt POKEY #1",
      "\tldy\t#\\$03",
      "\tsty\t\\$d21f\t; release POKEY #1",
      "",
      "\tsta\t\\$d40a\t; delay necessary for",
      "\tsta\t\\$d40a\t; accelerator boards",
      "",
      "\tlda\t#\\$ff",
      "${2:?loop}\tand\t\\$d20a\t; see if POKEY #0 is halted (\\$d20a = \\$ff)",
      "\tinx",
      "\tbne\t$2",
      "",
      "\tsty\t\\$d20f\t; release POKEY #0",
      "",
      "\tcmp\t#\\$ff",
      "\tbne\t${3:?mono}",
      "",
      "\tinx",
      "",
      "$3\trts",
      "$0"
    ],
    "description": "Stereo detect routine (2nd POKEY presence check)"
  },
  "DIVU 16x16": {
    "prefix": "divu_16x16",
    "body": [
      "; -----------------------------------------------------------------------------",
      "; Unsigned 16-bit / 16-bit division -> 16-bit quotient and remainder",
      ";",
      "; Input:",
      ";   ${1:FR0}     - dividend,  16-bit",
      ";   ${2:FR1}     - divisor,   16-bit",
      ";",
      "; Output:",
      ";   ${3:FR2}     - quotient,  16-bit",
      ";   ${4:FR3}     - remainder, 16-bit",
      ";",
      "; Temporary:",
      ";   $4+2   - high byte of working 17-bit remainder",
      ";",
      "; Clobbers:",
      ";   A, X, $1, $1+1, $4+2, flags",
      ";",
      "; Notes:",
      ";   $1 is destroyed.",
      ";   $2 is preserved.",
      ";   $2 must be non-zero.",
      ";   $4+2 is zero on return.",
      "; -----------------------------------------------------------------------------",
      "",
      "divu_16x16",
      "\tlda\t#0",
      "\tsta\t$3",
      "\tsta\t$3+1",
      "\tsta\t$4",
      "\tsta\t$4+1",
      "\tsta\t$4+2",
      "",
      "\tldx\t#16",
      "",
      "?divu_16x16_loop",
      "\t; Shift next dividend bit into remainder",
      "\tasl\t$1",
      "\trol\t$1+1",
      "",
      "\trol\t$4",
      "\trol\t$4+1",
      "\trol\t$4+2",
      "",
      "\t; quotient <<= 1",
      "\tasl\t$3",
      "\trol\t$3+1",
      "",
      "\t; if remainder >= divisor",
      "\tlda\t$4+2",
      "\tbne\t?divu_16x16_subtract",
      "",
      "\tlda\t$4+1",
      "\tcmp\t$2+1",
      "\tbcc\t?divu_16x16_no_subtract",
      "\tbne\t?divu_16x16_subtract",
      "",
      "\tlda\t$4",
      "\tcmp\t$2",
      "\tbcc\t?divu_16x16_no_subtract",
      "",
      "?divu_16x16_subtract",
      "\t; remainder -= divisor",
      "\tsec",
      "\tlda\t$4",
      "\tsbc\t$2",
      "\tsta\t$4",
      "",
      "\tlda\t$4+1",
      "\tsbc\t$2+1",
      "\tsta\t$4+1",
      "",
      "\tlda\t$4+2",
      "\tsbc\t#0",
      "\tsta\t$4+2",
      "",
      "\t; Set current quotient bit",
      "\tinc\t$3",
      "",
      "?divu_16x16_no_subtract",
      "\tdex",
      "\tbne\t?divu_16x16_loop",
      "",
      "\trts",
      "$0"
    ],
    "description": "Unsigned 16-bit / 16-bit division with 16-bit quotient and remainder"
  },
  "DIVU 8x8": {
    "prefix": "divu_8x8",
    "body": [
      "; -----------------------------------------------------------------------------",
      "; Unsigned 8-bit / 8-bit division -> 8-bit quotient and remainder",
      ";",
      "; Input:",
      ";   ${1:FR0}     - dividend, 8-bit",
      ";   ${2:FR1}     - divisor,  8-bit",
      ";",
      "; Output:",
      ";   ${3:FR2}     - quotient,  8-bit",
      ";   ${4:FR3}     - remainder, 8-bit",
      ";",
      "; Temporary:",
      ";   $4+1   - high byte of working remainder",
      ";",
      "; Clobbers:",
      ";   A, X, $1, $4+1, flags",
      ";",
      "; Notes:",
      ";   $1 is destroyed.",
      ";   $2 is preserved.",
      ";   $2 must be non-zero.",
      ";   $4+1 is zero on return.",
      "; -----------------------------------------------------------------------------",
      "",
      "divu_8x8",
      "\tlda\t#0",
      "\tsta\t$3",
      "\tsta\t$4",
      "\tsta\t$4+1",
      "",
      "\tldx\t#8",
      "",
      "?divu_8x8_loop",
      "\t; Shift next dividend bit into remainder",
      "\tasl\t$1",
      "\trol\t$4",
      "\trol\t$4+1",
      "",
      "\t; quotient <<= 1",
      "\tasl\t$3",
      "",
      "\t; if remainder >= divisor",
      "\tlda\t$4+1",
      "\tbne\t?divu_8x8_subtract",
      "",
      "\tlda\t$4",
      "\tcmp\t$2",
      "\tbcc\t?divu_8x8_no_subtract",
      "",
      "?divu_8x8_subtract",
      "\t; remainder -= divisor",
      "\tsec",
      "\tlda\t$4",
      "\tsbc\t$2",
      "\tsta\t$4",
      "",
      "\tlda\t$4+1",
      "\tsbc\t#0",
      "\tsta\t$4+1",
      "",
      "\t; Set current quotient bit",
      "\tinc\t$3",
      "",
      "?divu_8x8_no_subtract",
      "\tdex",
      "\tbne\t?divu_8x8_loop",
      "",
      "\trts",
      "$0"
    ],
    "description": "Unsigned 8-bit / 8-bit division with 8-bit quotient and remainder"
  },
  "MULU 16x16": {
    "prefix": "mulu_16x16",
    "body": [
      "; -----------------------------------------------------------------------------",
      "; Unsigned 16-bit x 16-bit multiplication -> 32-bit product",
      ";",
      "; Input:",
      ";   ${1:FR0}     - multiplicand, 16-bit",
      ";   ${2:FR1}     - multiplier,   16-bit",
      ";",
      "; Output:",
      ";   ${3:FR2}     - product,      32-bit",
      ";",
      "; Temporary:",
      ";   ${4:FR3}     - shifted multiplicand, 32-bit",
      ";",
      "; Clobbers:",
      ";   A, X, $2, $2+1, $4, $4+1, $4+2, $4+3, flags",
      ";",
      "; Notes:",
      ";   $1 is preserved.",
      ";   $2 is destroyed.",
      "; -----------------------------------------------------------------------------",
      "",
      "mulu_16x16",
      "\tlda\t#0",
      "\tsta\t$3",
      "\tsta\t$3+1",
      "\tsta\t$3+2",
      "\tsta\t$3+3",
      "",
      "\t; Extend multiplicand to 32 bits",
      "\tlda\t$1",
      "\tsta\t$4",
      "\tlda\t$1+1",
      "\tsta\t$4+1",
      "\tlda\t#0",
      "\tsta\t$4+2",
      "\tsta\t$4+3",
      "",
      "\tldx\t#16",
      "",
      "?mulu_16x16_loop",
      "\t; Test next bit of multiplier",
      "\tlsr\t$2+1",
      "\tror\t$2",
      "\tbcc\t?mulu_16x16_no_add",
      "",
      "\t; product += multiplicand",
      "\tclc",
      "\tlda\t$3",
      "\tadc\t$4",
      "\tsta\t$3",
      "",
      "\tlda\t$3+1",
      "\tadc\t$4+1",
      "\tsta\t$3+1",
      "",
      "\tlda\t$3+2",
      "\tadc\t$4+2",
      "\tsta\t$3+2",
      "",
      "\tlda\t$3+3",
      "\tadc\t$4+3",
      "\tsta\t$3+3",
      "",
      "?mulu_16x16_no_add",
      "\t; multiplicand <<= 1",
      "\tasl\t$4",
      "\trol\t$4+1",
      "\trol\t$4+2",
      "\trol\t$4+3",
      "",
      "\tdex",
      "\tbne\t?mulu_16x16_loop",
      "",
      "\trts",
      "$0"
    ],
    "description": "Unsigned 16-bit x 16-bit multiplication with 32-bit product"
  },
  "MULU 16x16 QS Fast": {
    "prefix": "mulu_16x16_qs_fast",
    "body": [
      "; -----------------------------------------------------------------------------",
      "; Unsigned 16-bit x 16-bit multiplication -> 32-bit product",
      ";",
      "; The multiplication is decomposed into four 8-bit products:",
      ";",
      ";   A = a1:a0",
      ";   B = b1:b0",
      ";",
      ";   A*B =",
      ";",
      ";       a0*b0",
      ";     + (a0*b1 << 8)",
      ";     + (a1*b0 << 8)",
      ";     + (a1*b1 << 16)",
      ";",
      "; Each 8-bit product is calculated using an exact quarter-square lookup:",
      ";",
      ";   Q(n) = floor(n*n / 4)",
      ";",
      ";   a*b = Q(a+b) - Q(abs(a-b))",
      ";",
      "; The internal 8x8 kernel uses the same wrapped-difference technique as",
      "; mulu_8x8_qs_fast, avoiding an explicit absolute-value calculation.",
      ";",
      "; Input:",
      ";   ${1:FR0}     - multiplicand, 16-bit",
      ";   ${2:FR1}     - multiplier,   16-bit",
      ";",
      "; Output:",
      ";   ${3:FR2}     - product,      32-bit",
      ";",
      "; Temporary:",
      ";   ${4:FR3}     - 4-byte workspace containing two table pointers",
      ";",
      "; Clobbers:",
      ";   A, X, Y, $4, $4+2, flags",
      ";",
      "; Notes:",
      ";   $1 and $2 are preserved.",
      ";   $1..$4 are expected to reside in zero page.",
      ";   $4 reserves four consecutive bytes: $4..$4+3.",
      ";   Decimal mode must be clear.",
      ";",
      ";   $4+1 and $4+3 contain persistent table-pointer high bytes.",
      ";   They must remain unchanged between calls.",
      ";",
      ";   mulu_16x16_qs_fast_init must be called once before the first multiply,",
      ";   and again if $4+1 or $4+3 are modified.",
      ";",
      ";   Lookup tables require 1536 bytes.",
      ";",
      ";   The 16x16 decomposition follows the conventional four-partial-product",
      ";   method. A highly optimized implementation of the same general approach",
      ";   can also be found in mult86 by Repose:",
      ";",
      ";   https://github.com/TobyLobster/multiply_test/blob/main/tests/mult86.a",
      ";",
      ";   This implementation deliberately favors a regular interface and",
      ";   readability over self-modifying code and register-resident output.",
      "; -----------------------------------------------------------------------------",
      "",
      "",
      "; -----------------------------------------------------------------------------",
      "; Initialize table pointers.",
      ";",
      "; Call once before using mulu_16x16_qs_fast.",
      "; -----------------------------------------------------------------------------",
      "",
      "mulu_16x16_qs_fast_init",
      "\tlda\t#>mulu_16x16_qs_fast?qs_sum_lo",
      "\tsta\t$4+1",
      "",
      "\tlda\t#>mulu_16x16_qs_fast?qs_sum_hi",
      "\tsta\t$4+3",
      "",
      "\trts",
      "",
      "",
      "; -----------------------------------------------------------------------------",
      "; Multiply",
      "; -----------------------------------------------------------------------------",
      "",
      "mulu_16x16_qs_fast",
      "\t; ---------------------------------------------------------------------",
      "\t; Start with:",
      "\t;",
      "\t;   result = a0*b0",
      "\t;",
      "\t; and clear the upper half of the result.",
      "\t; ---------------------------------------------------------------------",
      "",
      "\tlda\t$1",
      "\tsta\t$4",
      "\tsta\t$4+2",
      "",
      "\tldy\t$2",
      "\tjsr\t?mul8_qs",
      "",
      "\tsta\t$3",
      "\tstx\t$3+1",
      "",
      "\tlda\t#0",
      "\tsta\t$3+2",
      "\tsta\t$3+3",
      "",
      "",
      "\t; ---------------------------------------------------------------------",
      "\t; Add:",
      "\t;",
      "\t;   a0*b1 << 8",
      "\t;",
      "\t; $4 already points at tables indexed by a0.",
      "\t; ---------------------------------------------------------------------",
      "",
      "\tldy\t$2+1",
      "\tjsr\t?mul8_qs",
      "",
      "\tclc",
      "\tadc\t$3+1",
      "\tsta\t$3+1",
      "",
      "\ttxa",
      "\tadc\t$3+2",
      "\tsta\t$3+2",
      "",
      "\tbcc\t?p1_done",
      "\tinc\t$3+3",
      "",
      "?p1_done",
      "",
      "",
      "\t; ---------------------------------------------------------------------",
      "\t; Change the first 8-bit operand from a0 to a1.",
      "\t;",
      "\t; Both table pointers use the operand as their low byte.",
      "\t; ---------------------------------------------------------------------",
      "",
      "\tlda\t$1+1",
      "\tsta\t$4",
      "\tsta\t$4+2",
      "",
      "",
      "\t; ---------------------------------------------------------------------",
      "\t; Add:",
      "\t;",
      "\t;   a1*b0 << 8",
      "\t; ---------------------------------------------------------------------",
      "",
      "\tldy\t$2",
      "\tjsr\t?mul8_qs",
      "",
      "\tclc",
      "\tadc\t$3+1",
      "\tsta\t$3+1",
      "",
      "\ttxa",
      "\tadc\t$3+2",
      "\tsta\t$3+2",
      "",
      "\tbcc\t?p2_done",
      "\tinc\t$3+3",
      "",
      "?p2_done",
      "",
      "",
      "\t; ---------------------------------------------------------------------",
      "\t; Add:",
      "\t;",
      "\t;   a1*b1 << 16",
      "\t; ---------------------------------------------------------------------",
      "",
      "\tldy\t$2+1",
      "\tjsr\t?mul8_qs",
      "",
      "\tclc",
      "\tadc\t$3+2",
      "\tsta\t$3+2",
      "",
      "\ttxa",
      "\tadc\t$3+3",
      "\tsta\t$3+3",
      "",
      "\trts",
      "",
      "",
      "; -----------------------------------------------------------------------------",
      "; Internal unsigned 8x8 quarter-square multiply.",
      ";",
      "; Input:",
      ";   $4     - low-byte table pointer, low byte contains operand A",
      ";   $4+2   - high-byte table pointer, low byte contains operand A",
      ";   Y       - operand B",
      ";",
      "; Output:",
      ";   A       - product low byte",
      ";   X       - product high byte",
      ";",
      "; Clobbers:",
      ";   A, X, flags",
      ";",
      "; Y is preserved.",
      ";",
      "; The two pointers have already been initialized so that:",
      ";",
      ";   ($4),Y   -> low(Q(A+B))",
      ";   ($4+2),Y -> high(Q(A+B))",
      ";",
      "; Because the sum table contains 512 elements, normal 6502 indexed-indirect",
      "; page crossing naturally selects Q(A+B) for sums from 0 through 510.",
      "; -----------------------------------------------------------------------------",
      "",
      "?mul8_qs",
      "\t; X = B-A",
      "\t;",
      "\t; Carry tells us whether the difference is non-negative:",
      "\t;",
      "\t;   C=1 -> B >= A",
      "\t;   C=0 -> B <  A",
      "",
      "\ttya",
      "\tsec",
      "\tsbc\t$4",
      "\ttax",
      "",
      "",
      "\t; Load low byte of Q(A+B).",
      "\t;",
      "\t; LDA does not modify carry, therefore carry from B-A remains valid.",
      "",
      "\tlda\t($4),y",
      "\tbcc\t?mul8_negative",
      "",
      "",
      "\t; ---------------------------------------------------------------------",
      "\t; B >= A",
      "\t;",
      "\t; X = B-A",
      "\t;",
      "\t; product = Q(A+B) - Q(B-A)",
      "\t; ---------------------------------------------------------------------",
      "",
      "\tsbc\t?qs_sum_lo,x",
      "\tpha",
      "",
      "\tlda\t($4+2),y",
      "\tsbc\t?qs_sum_hi,x",
      "\ttax",
      "",
      "\tpla",
      "\trts",
      "",
      "",
      "?mul8_negative",
      "\t; ---------------------------------------------------------------------",
      "\t; B < A",
      "\t;",
      "\t; The 8-bit subtraction produced:",
      "\t;",
      "\t;   X = 256-(A-B)",
      "\t;",
      "\t; with C=0.",
      "\t;",
      "\t; The alternate table contains:",
      "\t;",
      "\t;   Q(256-X)-1",
      "\t;",
      "\t; Since SBC is entered with C=0:",
      "\t;",
      "\t;   Q(sum) - [Q(abs(diff))-1] - 1",
      "\t;",
      "\t; becomes:",
      "\t;",
      "\t;   Q(sum) - Q(abs(diff))",
      "\t; ---------------------------------------------------------------------",
      "",
      "\tsbc\t?qs_diff_neg_lo,x",
      "\tpha",
      "",
      "\tlda\t($4+2),y",
      "\tsbc\t?qs_diff_neg_hi,x",
      "\ttax",
      "",
      "\tpla",
      "\trts",
      "",
      "",
      "; -----------------------------------------------------------------------------",
      "; Lookup tables",
      ";",
      "; Q(A+B) requires values for 0..510.",
      ";",
      "; The sum table therefore contains 512 entries, with the last entry unused.",
      ";",
      "; The alternate difference table contains 256 entries.",
      ";",
      "; Only the first table must be explicitly page aligned. Every following",
      "; table occupies an integer number of pages and remains aligned.",
      ";",
      "; Changing ORG starts/moves an XEX segment, so no physical padding bytes",
      "; need to be emitted into the executable file.",
      "; -----------------------------------------------------------------------------",
      "",
      "\torg\t[[*/256]*256+\\$100]\t\t; align to next page boundary",
      "",
      "",
      "; -----------------------------------------------------------------------------",
      "; Q(n), low byte",
      ";",
      "; 512 entries.",
      "; -----------------------------------------------------------------------------",
      "",
      "?qs_sum_lo",
      "\t:512 dta l([#*#]/4)",
      "",
      "",
      "; -----------------------------------------------------------------------------",
      "; Q(n), high byte",
      ";",
      "; 512 entries.",
      "; -----------------------------------------------------------------------------",
      "",
      "?qs_sum_hi",
      "\t:512 dta h([#*#]/4)",
      "",
      "",
      "; -----------------------------------------------------------------------------",
      "; Alternate negative-difference table, low byte",
      ";",
      "; Entry 0 is unused.",
      ";",
      "; For index n=1..255:",
      ";",
      ";   table[n] = Q(256-n)-1",
      ";",
      "; For n=1..254 the value is non-negative and can be generated normally.",
      ";",
      "; For n=255:",
      ";",
      ";   Q(1)-1 = -1",
      ";",
      "; which is represented explicitly as \\$FFFF.",
      "; -----------------------------------------------------------------------------",
      "",
      "?qs_diff_neg_lo",
      "\tdta\t0",
      "\t:254 dta l([[255-#]*[255-#]/4]-1)",
      "\tdta\t\\$ff",
      "",
      "",
      "; -----------------------------------------------------------------------------",
      "; Alternate negative-difference table, high byte",
      "; -----------------------------------------------------------------------------",
      "",
      "?qs_diff_neg_hi",
      "\tdta\t0",
      "\t:254 dta h([[255-#]*[255-#]/4]-1)",
      "\tdta\t\\$ff",
      "$0"
    ],
    "description": "Fast unsigned 16-bit x 16-bit quarter-square multiplication with 32-bit product"
  },
  "MULU 8x8": {
    "prefix": "mulu_8x8",
    "body": [
      "; -----------------------------------------------------------------------------",
      "; Unsigned 8-bit x 8-bit multiplication -> 16-bit product",
      ";",
      "; Input:",
      ";   ${1:FR0}     - multiplicand, 8-bit",
      ";   ${2:FR1}     - multiplier,   8-bit",
      ";",
      "; Output:",
      ";   ${3:FR2}     - product,      16-bit",
      ";",
      "; Temporary:",
      ";   ${4:FR3}     - shifted multiplicand, 16-bit",
      ";",
      "; Clobbers:",
      ";   A, X, $2, $4, $4+1, flags",
      ";",
      "; Notes:",
      ";   $1 is preserved.",
      ";   $2 is destroyed.",
      "; -----------------------------------------------------------------------------",
      "",
      "mulu_8x8",
      "\tlda\t#0",
      "\tsta\t$3",
      "\tsta\t$3+1",
      "",
      "\t; Extend multiplicand to 16 bits",
      "\tlda\t$1",
      "\tsta\t$4",
      "\tlda\t#0",
      "\tsta\t$4+1",
      "",
      "\tldx\t#8",
      "",
      "?mulu_8x8_loop",
      "\t; Test next bit of multiplier",
      "\tlsr\t$2",
      "\tbcc\t?mulu_8x8_no_add",
      "",
      "\t; product += multiplicand",
      "\tclc",
      "\tlda\t$3",
      "\tadc\t$4",
      "\tsta\t$3",
      "",
      "\tlda\t$3+1",
      "\tadc\t$4+1",
      "\tsta\t$3+1",
      "",
      "?mulu_8x8_no_add",
      "\t; multiplicand <<= 1",
      "\tasl\t$4",
      "\trol\t$4+1",
      "",
      "\tdex",
      "\tbne\t?mulu_8x8_loop",
      "",
      "\trts",
      "$0"
    ],
    "description": "Unsigned 8-bit x 8-bit multiplication with 16-bit product"
  },
  "MULU 8x8 Optimized": {
    "prefix": "mulu_8x8_opt",
    "body": [
      "; -----------------------------------------------------------------------------",
      "; Unsigned 8-bit x 8-bit multiplication -> 16-bit product",
      ";",
      "; Optimized shift-add implementation.",
      ";",
      "; Based on a multiplication loop by Leif Stensson, published by Niels Möller:",
      "; https://www.lysator.liu.se/~nisse/misc/6502-mul.html",
      ";",
      "; Adapted for this snippet to use the standard ${1:FR0}/${2:FR1}/${3:FR2} interface",
      "; and preserve both input operands.",
      ";",
      "; Input:",
      ";   $1     - multiplicand, 8-bit",
      ";   $2     - multiplier,   8-bit",
      ";",
      "; Output:",
      ";   $3     - product,      16-bit",
      ";",
      "; Clobbers:",
      ";   A, X, flags",
      ";",
      "; Notes:",
      ";   $1 and $2 are preserved.",
      ";   Decimal mode must be clear.",
      ";",
      "; The multiplier is copied to the low byte of the partial product.",
      "; During each iteration A:$3 is shifted right, while successive",
      "; multiplier bits are consumed through carry.",
      "; -----------------------------------------------------------------------------",
      "",
      "mulu_8x8_opt",
      "\t; Copy multiplier to partial product",
      "\tlda\t$2",
      "\tsta\t$3",
      "",
      "\t; High byte of partial product",
      "\tlda\t#0",
      "\tldx\t#8",
      "",
      "\t; Get first multiplier bit",
      "\tlsr\t$3",
      "",
      "?mulu_8x8_opt_loop",
      "\tbcc\t?mulu_8x8_opt_no_add",
      "",
      "\t; Add multiplicand to high byte of partial product",
      "\tclc",
      "\tadc\t$1",
      "",
      "?mulu_8x8_opt_no_add",
      "\t; Shift A:$3 right and get next multiplier bit",
      "\tror\t@",
      "\tror\t$3",
      "",
      "\tdex",
      "\tbne\t?mulu_8x8_opt_loop",
      "",
      "\t; Store high byte of product",
      "\tsta\t$3+1",
      "",
      "\trts",
      "$0"
    ],
    "description": "Optimized unsigned 8-bit x 8-bit shift-add multiplication with 16-bit product"
  },
  "MULU 8x8 QS": {
    "prefix": "mulu_8x8_qs",
    "body": [
      "; -----------------------------------------------------------------------------",
      "; Unsigned 8-bit x 8-bit multiplication -> 16-bit product",
      ";",
      "; Quarter-square method:",
      ";",
      ";   Q(n) = floor(n*n / 4)",
      ";",
      ";   a*b = Q(a+b) - Q(abs(a-b))",
      ";",
      "; Lookup tables contain Q(0)..Q(255).",
      ";",
      "; For a+b >= 256:",
      ";",
      ";   Q(256+n) = Q(n) + \\$4000 + (n << 7)",
      ";",
      "; Input:",
      ";   ${1:FR0}     - multiplicand, 8-bit",
      ";   ${2:FR1}     - multiplier,   8-bit",
      ";",
      "; Output:",
      ";   ${3:FR2}     - product,      16-bit",
      ";",
      "; Clobbers:",
      ";   A, Y, flags",
      ";",
      "; Notes:",
      ";   $1 and $2 are preserved.",
      ";   Decimal mode must be clear.",
      ";   Lookup tables require 512 bytes.",
      "; -----------------------------------------------------------------------------",
      "",
      "mulu_8x8_qs",
      "\t; -------------------------------------------------------------",
      "\t; product = Q(a+b)",
      "\t; -------------------------------------------------------------",
      "",
      "\tclc",
      "\tlda\t$1",
      "\tadc\t$2",
      "\ttay",
      "",
      "\t; C contains bit 8 of a+b",
      "\tlda\t?qs_lo,y",
      "\tsta\t$3",
      "\tlda\t?qs_hi,y",
      "\tsta\t$3+1",
      "",
      "\tbcc\t?sum_ready",
      "",
      "\t; -------------------------------------------------------------",
      "\t; a+b = 256+Y",
      "\t;",
      "\t; Q(256+Y) = Q(Y) + \\$4000 + (Y << 7)",
      "\t;",
      "\t; Y << 7:",
      "\t;",
      "\t;   low  byte = bit 0 of Y shifted to bit 7",
      "\t;   high byte = Y >> 1",
      "\t; -------------------------------------------------------------",
      "",
      "\ttya",
      "\tlsr\t@",
      "\ttay\t\t\t\t; Y = original Y >> 1, C = original bit 0",
      "",
      "\tlda\t#0",
      "\tror\t@\t\t\t; A = \\$80 if original Y was odd",
      "\t\t\t\t\t; C = 0",
      "",
      "\tadc\t$3",
      "\tsta\t$3",
      "",
      "\ttya",
      "\tadc\t#\\$40\t\t\t; +\\$4000 and carry from low byte",
      "\tadc\t$3+1",
      "\tsta\t$3+1",
      "",
      "?sum_ready",
      "\t; -------------------------------------------------------------",
      "\t; Y = abs(a-b)",
      "\t; -------------------------------------------------------------",
      "",
      "\tlda\t$1",
      "\tsec",
      "\tsbc\t$2",
      "\tbcs\t?diff_ready",
      "",
      "\teor\t#\\$ff",
      "\tadc\t#1\t\t\t; C=0 after failed BCS",
      "",
      "?diff_ready",
      "\ttay",
      "",
      "\t; -------------------------------------------------------------",
      "\t; product -= Q(abs(a-b))",
      "\t; -------------------------------------------------------------",
      "",
      "\tsec",
      "\tlda\t$3",
      "\tsbc\t?qs_lo,y",
      "\tsta\t$3",
      "",
      "\tlda\t$3+1",
      "\tsbc\t?qs_hi,y",
      "\tsta\t$3+1",
      "",
      "\trts",
      "",
      "",
      "; -----------------------------------------------------------------------------",
      "; Quarter-square lookup tables",
      ";",
      "; Q(n) = floor(n*n / 4), n = 0..255",
      "; -----------------------------------------------------------------------------",
      "",
      "?qs_lo",
      ":256\tdta l([#*#]/4)",
      "",
      "?qs_hi",
      ":256\tdta h([#*#]/4)",
      "$0"
    ],
    "description": "Unsigned 8-bit x 8-bit quarter-square multiplication with 16-bit product"
  },
  "MULU 8x8 QS Fast": {
    "prefix": "mulu_8x8_qs_fast",
    "body": [
      "; -----------------------------------------------------------------------------",
      "; Fast unsigned 8-bit x 8-bit multiplication -> 16-bit product",
      ";",
      "; Quarter-square method:",
      ";",
      ";   Q(n) = floor(n*n / 4)",
      ";",
      ";   a*b = Q(a+b) - Q(abs(a-b))",
      ";",
      "; This implementation avoids explicitly calculating abs(a-b).",
      "; A second lookup table is used when the subtraction produces",
      "; a negative difference.",
      ";",
      "; Based on mult66 by TobyLobster:",
      "; https://github.com/TobyLobster/multiply_test/blob/main/tests/mult66.a",
      ";",
      "; mult66 is based on multiplication code from Nick Jameson's",
      "; BBC Micro 3D Demo (1994).",
      ";",
      "; Input:",
      ";   ${1:FR0}     - multiplicand, 8-bit",
      ";   ${2:FR1}     - multiplier,   8-bit",
      ";",
      "; Output:",
      ";   ${3:FR2}     - product,      16-bit",
      ";",
      "; Temporary:",
      ";   ${4:FR3}     - 4-byte workspace used as two table pointers",
      ";",
      "; Clobbers:",
      ";   A, X, Y, $4..$4+3, flags",
      ";",
      "; Notes:",
      ";   $1 and $2 are preserved.",
      ";   $1..$4 are expected to reside in zero page.",
      ";   $4 uses four consecutive zero-page bytes as two table pointers.",
      ";   Decimal mode must be clear.",
      ";",
      ";   mulu_8x8_qs_fast_init must be called once before the first multiply,",
      ";   and again if $4+1 or $4+3 are modified.",
      ";",
      ";   Lookup tables require 1536 bytes.",
      ";",
      "; IMPORTANT:",
      ";   $4+1 and $4+3 contain persistent table-pointer high bytes.",
      ";   They must remain unchanged between calls to mulu_8x8_qs_fast.",
      ";",
      "; -----------------------------------------------------------------------------",
      "",
      "",
      "; -----------------------------------------------------------------------------",
      "; Initialize table pointers.",
      ";",
      "; Call once before using mulu_8x8_qs_fast.",
      "; -----------------------------------------------------------------------------",
      "",
      "mulu_8x8_qs_fast_init",
      "\tlda\t#>mulu_8x8_qs_fast?qs_sum_lo",
      "\tsta\t$4+1",
      "",
      "\tlda\t#>mulu_8x8_qs_fast?qs_sum_hi",
      "\tsta\t$4+3",
      "",
      "\trts",
      "",
      "",
      "; -----------------------------------------------------------------------------",
      "; Multiply",
      "; -----------------------------------------------------------------------------",
      "",
      "mulu_8x8_qs_fast",
      "\t; Build pointers:",
      "\t;",
      "\t;   $4   -> Q low table  + $1",
      "\t;   $4+2 -> Q high table + $1",
      "\t;",
      "\t; With Y=$2, indirect indexed addressing gives:",
      "\t;",
      "\t;   table[$1+$2]",
      "",
      "\tldx\t$1",
      "\tstx\t$4",
      "\tstx\t$4+2",
      "",
      "\tldy\t$2",
      "",
      "",
      "\t; ---------------------------------------------------------------------",
      "\t; Calculate $2-$1.",
      "\t;",
      "\t; X receives the 8-bit difference.",
      "\t;",
      "\t; Carry:",
      "\t;   C=1  $2 >= $1",
      "\t;   C=0  $2 <  $1",
      "\t; ---------------------------------------------------------------------",
      "",
      "\ttya",
      "\tsec",
      "\tsbc\t$4",
      "\ttax",
      "",
      "",
      "\t; ---------------------------------------------------------------------",
      "\t; Load low byte of Q($1+$2).",
      "\t;",
      "\t; LDA does not modify carry, so carry from the subtraction above",
      "\t; is preserved and immediately selects the appropriate difference",
      "\t; table.",
      "\t; ---------------------------------------------------------------------",
      "",
      "\tlda\t($4),y",
      "\tbcc\t?negative_difference",
      "",
      "",
      "\t; ---------------------------------------------------------------------",
      "\t; $2 >= $1",
      "\t;",
      "\t; X = $2-$1",
      "\t;",
      "\t; product = Q($1+$2) - Q($2-$1)",
      "\t; ---------------------------------------------------------------------",
      "",
      "\tsbc\t?qs_sum_lo,x",
      "\tsta\t$3",
      "",
      "\tlda\t($4+2),y",
      "\tsbc\t?qs_sum_hi,x",
      "\tsta\t$3+1",
      "",
      "\trts",
      "",
      "",
      "?negative_difference",
      "\t; ---------------------------------------------------------------------",
      "\t; $2 < $1",
      "\t;",
      "\t; The 8-bit subtraction produced:",
      "\t;",
      "\t;   X = 256-($1-$2)",
      "\t;",
      "\t; and C=0.",
      "\t;",
      "\t; The alternate table contains:",
      "\t;",
      "\t;   Q(256-X)-1",
      "\t;",
      "\t; SBC with C=0 subtracts one additional unit:",
      "\t;",
      "\t;   Q(sum) - [Q(abs(diff))-1] - 1",
      "\t;",
      "\t; which simplifies to:",
      "\t;",
      "\t;   Q(sum) - Q(abs(diff))",
      "\t; ---------------------------------------------------------------------",
      "",
      "\tsbc\t?qs_diff_neg_lo,x",
      "\tsta\t$3",
      "",
      "\tlda\t($4+2),y",
      "\tsbc\t?qs_diff_neg_hi,x",
      "\tsta\t$3+1",
      "",
      "\trts",
      "",
      "",
      "; -----------------------------------------------------------------------------",
      "; Lookup tables",
      ";",
      "; Q(sum) needs entries for values 0..510.",
      ";",
      "; The alternate difference table needs entries 0..255.",
      ";",
      "; Only the first table has to be explicitly aligned. All following table",
      "; parts have sizes that are multiples of 256 bytes, so they remain aligned.",
      ";",
      "; XEX can start a new segment at the new origin, therefore this alignment",
      "; does not emit padding bytes into the file.",
      "; -----------------------------------------------------------------------------",
      "",
      "\torg\t[[*/256]*256+\\$100]\t\t; align to page boundary",
      "",
      "",
      "; -----------------------------------------------------------------------------",
      "; Q(n) low byte",
      ";",
      "; 512 entries, n=0..511.",
      "; Entry 511 is unused.",
      "; -----------------------------------------------------------------------------",
      "",
      "?qs_sum_lo",
      "\t:512 dta l([#*#]/4)",
      "",
      "",
      "; -----------------------------------------------------------------------------",
      "; Q(n) high byte",
      "; -----------------------------------------------------------------------------",
      "",
      "?qs_sum_hi",
      "\t:512 dta h([#*#]/4)",
      "",
      "",
      "; -----------------------------------------------------------------------------",
      "; Alternate difference table, low byte",
      ";",
      "; Entry 0 is unused by the negative-difference path.",
      ";",
      "; For index n=1..255:",
      ";",
      ";   table[n] = Q(256-n)-1",
      ";",
      "; The repeat counter runs from 0..254, therefore:",
      ";",
      ";   255-# = 255..1",
      ";",
      "; The result is explicitly masked to 16 bits because Q(1)-1 = -1,",
      "; which must be represented as \\$FFFF.",
      "; -----------------------------------------------------------------------------",
      "",
      "?qs_diff_neg_lo",
      "\tdta\t0",
      "\t:255 dta l([[[255-#]*[255-#]/4]-1]&\\$ffff)",
      "",
      "?qs_diff_neg_hi",
      "\tdta\t0",
      "\t:255 dta h([[[255-#]*[255-#]/4]-1]&\\$ffff)",
      "$0"
    ],
    "description": "Fast unsigned 8-bit x 8-bit quarter-square multiplication with 16-bit product"
  },
  "MULU 8x8 Unrolled": {
    "prefix": "mulu_8x8_unrolled",
    "body": [
      "; -----------------------------------------------------------------------------",
      "; Unsigned 8-bit x 8-bit multiplication -> 16-bit product",
      ";",
      "; Unrolled modified shift-add implementation.",
      ";",
      "; Based on an implementation by djmips:",
      "; https://codebase64.net/doku.php?id=base:8bit_multiplication_16bit_product_fast_no_tables",
      ";",
      "; The inner-loop technique is credited there to Damon Slye,",
      "; CALL APPLE, June 1983.",
      ";",
      "; Adapted for this snippet to use the standard ${1:FR0}/${2:FR1}/${3:FR2} interface",
      "; and preserve both input operands.",
      ";",
      "; Input:",
      ";   $1     - multiplicand, 8-bit",
      ";   $2     - multiplier,   8-bit",
      ";",
      "; Output:",
      ";   $3     - product,      16-bit",
      ";",
      "; Clobbers:",
      ";   A, flags",
      ";",
      "; Notes:",
      ";   $1 and $2 are preserved.",
      ";   X and Y are preserved.",
      ";   Decimal mode must be clear.",
      ";",
      "; The multiplicand minus one is temporarily stored in $3+1.",
      "; When a multiplier bit is set, ADC is entered with C=1, so:",
      ";",
      ";   A + (multiplicand - 1) + C",
      ";",
      "; is equivalent to:",
      ";",
      ";   A + multiplicand",
      ";",
      "; This avoids a CLC before every addition.",
      "; -----------------------------------------------------------------------------",
      "",
      "mulu_8x8_unrolled",
      "\t; A zero multiplicand requires special handling because the",
      "\t; multiplicand-1 optimization would otherwise wrap to \\$ff.",
      "\tlda\t$1",
      "\tbeq\t?mulu_8x8_unrolled_zero",
      "",
      "\t; Temporary addend = multiplicand - 1",
      "\tsec",
      "\tsbc\t#1",
      "\tsta\t$3+1",
      "",
      "\t; Copy multiplier to the low byte of the partial product",
      "\tlda\t$2",
      "\tsta\t$3",
      "",
      "\t; High byte of partial product",
      "\tlda\t#0",
      "",
      "\t; Get first multiplier bit",
      "\tlsr\t$3",
      "\tbcc\t?mulu_8x8_unrolled_bit1",
      "",
      "\t; C=1, therefore:",
      "\t; A + ($1-1) + 1 = A + $1",
      "\tadc\t$3+1",
      "\tror\t@",
      "",
      "?mulu_8x8_unrolled_bit1",
      "\tror\t$3",
      "\tbcc\t?mulu_8x8_unrolled_bit2",
      "\tadc\t$3+1",
      "",
      "?mulu_8x8_unrolled_bit2",
      "\tror\t@",
      "\tror\t$3",
      "\tbcc\t?mulu_8x8_unrolled_bit3",
      "\tadc\t$3+1",
      "",
      "?mulu_8x8_unrolled_bit3",
      "\tror\t@",
      "\tror\t$3",
      "\tbcc\t?mulu_8x8_unrolled_bit4",
      "\tadc\t$3+1",
      "",
      "?mulu_8x8_unrolled_bit4",
      "\tror\t@",
      "\tror\t$3",
      "\tbcc\t?mulu_8x8_unrolled_bit5",
      "\tadc\t$3+1",
      "",
      "?mulu_8x8_unrolled_bit5",
      "\tror\t@",
      "\tror\t$3",
      "\tbcc\t?mulu_8x8_unrolled_bit6",
      "\tadc\t$3+1",
      "",
      "?mulu_8x8_unrolled_bit6",
      "\tror\t@",
      "\tror\t$3",
      "\tbcc\t?mulu_8x8_unrolled_bit7",
      "\tadc\t$3+1",
      "",
      "?mulu_8x8_unrolled_bit7",
      "\tror\t@",
      "\tror\t$3",
      "\tbcc\t?mulu_8x8_unrolled_bit8",
      "\tadc\t$3+1",
      "",
      "?mulu_8x8_unrolled_bit8",
      "\tror\t@",
      "\tror\t$3",
      "",
      "\t; A contains product high byte",
      "\tsta\t$3+1",
      "",
      "\trts",
      "",
      "?mulu_8x8_unrolled_zero",
      "\tlda\t#0",
      "\tsta\t$3",
      "\tsta\t$3+1",
      "\trts",
      "$0"
    ],
    "description": "Unrolled optimized unsigned 8-bit x 8-bit shift-add multiplication with 16-bit product"
  },
  "Print HEX 8-bit": {
    "prefix": "print_hex8",
    "body": [
      "; -----------------------------------------------------------------------------",
      "; Print an 8-bit value as two uppercase hexadecimal digits.",
      ";",
      "; Input:",
      ";   A       - value to print",
      ";",
      "; Output:",
      ";   Two hexadecimal characters: 00..FF",
      ";",
      "; Clobbers:",
      ";   A, flags",
      ";   plus any registers clobbered by ${1:print_char}",
      ";",
      "; Notes:",
      ";   $1 must print the character passed in A.",
      ";   Decimal mode is used temporarily for hexadecimal digit conversion.",
      ";   Decimal mode is clear on return.",
      "; -----------------------------------------------------------------------------",
      "",
      "print_hex8",
      "\tpha",
      "",
      "\t; Print upper nibble.",
      "\tlsr\t@",
      "\tlsr\t@",
      "\tlsr\t@",
      "\tlsr\t@",
      "\tjsr\t?print_hex_digit",
      "",
      "\t; Restore the original value.",
      "\t;",
      "\t; Execution then falls through directly into ?print_hex_digit",
      "\t; to print the lower nibble.",
      "\tpla",
      "",
      "",
      "; -----------------------------------------------------------------------------",
      "; Convert the low nibble of A to an uppercase hexadecimal digit and print it.",
      ";",
      "; A small 6502 decimal-mode trick is used here:",
      ";",
      ";   0..9:",
      ";       CMP #\\$0A leaves C=0",
      ";       decimal ADC #'0' produces '0'..'9'",
      ";",
      ";   10..15:",
      ";       CMP #\\$0A leaves C=1",
      ";       decimal ADC #'0' uses the carry together with BCD correction",
      ";       to produce 'A'..'F'",
      ";",
      "; For example:",
      ";",
      ";   \\$0A + \\$30 + 1 -> \\$41  ('A')",
      ";   \\$0F + \\$30 + 1 -> \\$46  ('F')",
      "; -----------------------------------------------------------------------------",
      "",
      "?print_hex_digit",
      "\tand\t#\\$0f",
      "\tcmp\t#\\$0a",
      "",
      "\tsed",
      "\tadc\t#'0'",
      "\tcld",
      "",
      "\t; Tail call.",
      "\t;",
      "\t; There is no need for JSR $1 followed by RTS.",
      "\t; $1's RTS uses the return address already present on the stack:",
      "\t;",
      "\t;   - after printing the upper nibble, it returns to print_hex8",
      "\t;   - after printing the lower nibble, it returns directly to the caller",
      "\t;     of print_hex8",
      "\tjmp\t$1",
      "$0"
    ],
    "description": "Print an 8-bit value as two uppercase hexadecimal digits"
  },
  "Wait Frame RTC": {
    "prefix": "wait_frame_rtc",
    "body": [
      "; -----------------------------------------------------------------------------",
      "; Wait for the next video frame using the Atari OS real-time clock.",
      ";",
      "; RTCLOK+2 (\\$14) is incremented once per frame by the OS vertical blank",
      "; interrupt handler.",
      ";",
      "; The current value is sampled and the routine waits until it changes.",
      ";",
      "; Clobbers:",
      ";   A, flags",
      ";",
      "; Notes:",
      ";   Requires the Atari OS vertical blank interrupt to be active.",
      ";   Does not provide synchronization to the exact beginning of vertical blank.",
      ";   The caller continues after the OS VBI handler has updated RTCLOK+2",
      ";   and returned.",
      "; -----------------------------------------------------------------------------",
      "",
      "wait_frame_rtc",
      "\tlda\t\\$14",
      "",
      "?wait_frame_rtc",
      "\tcmp\t\\$14",
      "\tbeq\t?wait_frame_rtc",
      "",
      "\trts",
      "$0"
    ],
    "description": "Wait for the next video frame using the OS real-time clock"
  },
  "Wait Frame VCOUNT": {
    "prefix": "wait_frame_vcount",
    "body": [
      "; -----------------------------------------------------------------------------",
      "; Wait for the next video frame using the ANTIC VCOUNT register.",
      ";",
      "; The routine first waits for VCOUNT (\\$D40B) to wrap to zero, then waits",
      "; until it advances again.",
      ";",
      "; This synchronizes execution to the beginning of a new video frame without",
      "; depending on the Atari OS or vertical blank interrupts.",
      ";",
      "; Clobbers:",
      ";   A, flags",
      ";",
      "; Notes:",
      ";   Does not require the Atari OS.",
      ";   Does not require interrupts to be enabled.",
      ";   VCOUNT counts ANTIC scan-line pairs rather than individual scan lines.",
      ";   The routine returns shortly after VCOUNT advances from zero.",
      "; -----------------------------------------------------------------------------",
      "",
      "wait_frame_vcount",
      "",
      "?wait_frame_vcount_zero",
      "\tlda\t\\$d40b",
      "\tbne\t?wait_frame_vcount_zero",
      "",
      "?wait_frame_vcount_start",
      "\tlda\t\\$d40b",
      "\tbeq\t?wait_frame_vcount_start",
      "",
      "\trts",
      "$0"
    ],
    "description": "Wait for the next video frame using the ANTIC VCOUNT register"
  }
}
