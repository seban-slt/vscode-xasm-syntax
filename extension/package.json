{
  "name": "xasm-syntax",
  "displayName": "XASM Syntax Highlighting",
  "description": "Provides syntax highlighting for XASM assembler source files (.asx, .xsm) in Visual Studio Code",
  "version": "0.0.15",
  "publisher": "SLT^TQA",
  "license": "Unlicense",
  "repository": {
    "type": "git",
    "url": "https://github.com/seban-slt/vscode-xasm-syntax.git"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "icon": "images/icon_256.png",
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "xasm",
        "aliases": [
          "XASM",
          "xasm"
        ],
        "extensions": [
          ".asx",
          ".xsm"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "xasm",
        "scopeName": "source.xasm",
        "path": "./syntaxes/xasm.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "xasm",
        "path": "./snippets/xasm.json"
      }
    ]
  }
}
