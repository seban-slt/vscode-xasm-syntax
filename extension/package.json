{
  "name": "xasm-syntax",
  "displayName": "XASM Toolkit",
  "description": "XASM support for Visual Studio Code: syntax highlighting, snippets, and project initialization for .asx and .xsm files",
  "version": "0.1.1",
  "publisher": "seban-slt",
  "pricing": "Free",
  "license": "Unlicense",
  "repository": {
    "type": "git",
    "url": "https://github.com/seban-slt/vscode-xasm-syntax.git"
  },
  "bugs": {
    "url": "https://github.com/seban-slt/vscode-xasm-syntax/issues"
  },
  "homepage": "https://github.com/seban-slt/vscode-xasm-syntax",
  "engines": {
    "vscode": "^1.80.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onCommand:xasm.initializeProject"
  ],
  "icon": "images/icon_256.png",
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "contributes": {
    "commands": [
      {
        "command": "xasm.initializeProject",
        "title": "Initialize Project",
        "category": "XASM"
      }
    ],
    "languages": [
      {
        "id": "xasm",
        "aliases": [
          "XASM",
          "xasm"
        ],
        "extensions": [
          ".asx",
          ".xsm"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "xasm",
        "scopeName": "source.xasm",
        "path": "./syntaxes/xasm.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "xasm",
        "path": "./snippets/xasm.json"
      }
    ],
    "configurationDefaults": {
      "[xasm]": {
        "editor.colorDecorators": false
      }
    }
  },
  "keywords": [
    "xasm",
    "6502",
    "atari",
    "assembly",
    "assembler"
  ]
}
